# 复制成 .env 再填；.env 不进 git
# 只有真模型评估（docker compose --profile eval ...）会用到这些，压测一律打 mock-llm
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_EVAL_MODEL=deepseek-flash
# 单价：元 / 百万 token。见 https://api-docs.deepseek.com/zh-cn/quick_start/pricing ，注意分高峰 / 空闲时段
DEEPSEEK_PRICE_INPUT=
DEEPSEEK_PRICE_CACHE_HIT=
DEEPSEEK_PRICE_OUTPUT=
